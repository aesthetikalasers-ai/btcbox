{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": { "@/*": ["./src/*"] },
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  // `src/_unused` holds detached experiments that no route or page imports.
  // They are retained for reference but must not block the build. `e2e` contains
  // Playwright specs compiled/run separately; they are not part of the app bundle.
  "exclude": ["node_modules", "dist", "src/_unused", "scripts", "e2e"]
}
